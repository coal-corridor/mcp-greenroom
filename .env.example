# Copy to .env for local overrides. Never commit .env.
# Every variable has a safe default: the slice runs with none of these set.
# Names follow the spec. The config module is the source of truth once it exists.

# MCP_GREENROOM_ENV=dev
# MCP_GREENROOM_API=http://localhost:8000
# MCP_GREENROOM_TOKEN=

# Classifier provider: replay (default) or live.
# MCP_GREENROOM_RISK_PROVIDER=replay

# Only for the one recording run. Keep the key in the shell, not in a file.
# MCP_GREENROOM_MODEL_BASE_URL=
# MCP_GREENROOM_MODEL=
# MCP_GREENROOM_MODEL_API_KEY=
