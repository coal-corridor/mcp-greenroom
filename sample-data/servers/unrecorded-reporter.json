{
  "server": {
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "com.examplebank/unrecorded-reporter",
    "title": "Monthly reporter",
    "description": "Builds a monthly summary from account totals.",
    "version": "0.1.0",
    "repository": {
      "url": "https://git.examplebank.com/mcp/unrecorded-reporter",
      "source": "github"
    },
    "packages": [
      {
        "registryType": "npm",
        "registryBaseUrl": "https://registry.npmjs.org",
        "identifier": "@examplebank/unrecorded-reporter-mcp",
        "version": "0.1.0",
        "transport": {
          "type": "stdio"
        }
      }
    ]
  },
  "tools": [
    {
      "name": "monthly_summary",
      "description": "Summarise one month of account totals as a short table.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string"
          }
        },
        "required": [
          "month"
        ]
      }
    }
  ]
}
